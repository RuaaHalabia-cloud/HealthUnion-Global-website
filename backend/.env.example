# Database (Railway MongoDB plugin)
MONGO_URL=mongodb://user:password@host:port
DB_NAME=healthunion
APP_NAME=healthunion

# Allowed frontend origins, comma separated, no trailing slash
CORS_ORIGINS=https://healthunionglobal.com,https://www.healthunionglobal.com

# Email notifications for contact form submissions
EMAIL_PROVIDER=smtp
EMAIL_FROM=info@healthunionglobal.com
EMAIL_TO=info@healthunionglobal.com
EMAIL_BCC=lucas@industrialdecision.com

# SMTP credentials, Google Workspace
# SMTP_PASSWORD must be a 16 character app password, not the mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@healthunionglobal.com
SMTP_PASSWORD=
